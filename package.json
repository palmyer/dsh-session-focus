{
  "name": "dsh-session-focus",
  "version": "0.3.0-fork.10",
  "description": "Puts pinned, running, finished-but-unopened and currently open sessions in one section at the top of the DSH Web sidebar. Fork of dsh-pinned-sessions that also merges the native registry pin set.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palmyer/dsh-session-focus.git"
  },
  "homepage": "https://github.com/palmyer/dsh-session-focus#readme",
  "bugs": {
    "url": "https://github.com/palmyer/dsh-session-focus/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "sessions",
    "pinned"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "tests"
  ],
  "scripts": {
    "test": "node tests/selfcheck.cjs"
  },
  "dsh": {
    "id": "dsh-session-focus",
    "name": "Session focus",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
